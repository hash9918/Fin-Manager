# HTTP port for the API server.
PORT=4000
# MongoDB connection string for the API database.
MONGODB_URI=mongodb://127.0.0.1:27017/finmanager
# Web app origin allowed to make credentialed requests.
WEB_ORIGIN=http://localhost:5173
# Pino log level (fatal, error, warn, info, debug, trace).
LOG_LEVEL=info
